<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CL.NetUtils</RootNamespace>
    <AssemblyName>CL.NetUtils</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CodeLogic.NetUtils</PackageId>
    <PackageTags>dns;dnsbl;geoip;geolocation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Zyntal.com</Authors>
    <Description>DNSBL blacklist checking and IP geolocation services for CodeLogic 5 applications</Description>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
    <InternalsVisibleTo Include="NetUtils.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>