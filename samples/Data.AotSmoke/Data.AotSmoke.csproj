<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native AOT smoke test for CL.Data: `dotnet publish -c Release -p:PublishAot=true` must
       produce no trim/AOT warnings from CL.Data or its providers. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CL.Data.Sqlite\CL.Data.Sqlite.csproj" />
    <ProjectReference Include="..\..\CL.Data\generator\CL.Data.Generator\CL.Data.Generator.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>
</Project>
