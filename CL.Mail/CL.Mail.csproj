<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CL.Mail</RootNamespace>
    <AssemblyName>CL.Mail</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CodeLogic.Mail</PackageId>
    <PackageTags>smtp;imap;email;template</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Zyntal.com</Authors>
    <Description>SMTP/IMAP email library with template engine for CodeLogic 4 applications</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="MimeKit" Version="4.*" />
  </ItemGroup>  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>