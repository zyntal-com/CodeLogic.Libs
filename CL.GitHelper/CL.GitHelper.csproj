<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CL.GitHelper</RootNamespace>
    <AssemblyName>CL.GitHelper</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CodeLogic.GitHelper</PackageId>
    <PackageTags>git;repository;libgit2</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Zyntal.com</Authors>
    <Description>Git repository management library for CodeLogic 5 applications</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.32.*" />
  </ItemGroup>  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>