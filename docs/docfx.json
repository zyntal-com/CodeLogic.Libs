{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "CL.Common/CL.Common.csproj",
            "CL.GitHelper/CL.GitHelper.csproj",
            "CL.Imaging/CL.Imaging.csproj",
            "CL.Mail/CL.Mail.csproj",
            "CL.Data/CL.Data.csproj",
            "CL.Data.MySql/CL.Data.MySql.csproj",
            "CL.Data.PostgreSql/CL.Data.PostgreSql.csproj",
            "CL.Data.SqlServer/CL.Data.SqlServer.csproj",
            "CL.Data.Sqlite/CL.Data.Sqlite.csproj",
            "CL.NetUtils/CL.NetUtils.csproj",
            "CL.SocialConnect/CL.SocialConnect.csproj",
            "CL.Storage/CL.Storage.csproj",
            "CL.SystemStats/CL.SystemStats.csproj",
            "CL.TwoFactorAuth/CL.TwoFactorAuth.csproj",
            "CL.GameNetQuery/CL.GameNetQuery.csproj"
          ],
          "src": "../"
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["libs/**.md", "libs/**/toc.yml", "toc.yml", "getting-started.md", "index.md"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "dest": "../docs-output",
    "globalMetadata": {
      "_appTitle": "CodeLogic Libraries",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/logo.svg",
      "_enableSearch": true,
      "_appFooter": "Copyright &copy; 2026 Zyntal.com &middot; MIT-licensed &middot; Built with <a href='https://dotnet.github.io/docfx'>DocFX</a>.",
      "_appName": "CodeLogic Libraries",
      "_disableContribution": false
    },
    "template": ["default", "modern", "templates/cl"],
    "sitemap": {
      "baseUrl": "https://zyntal-com.github.io/CodeLogic.Libs"
    },
    "xref": [],
    "exportRawModel": false,
    "exportViewModel": false
  }
}
