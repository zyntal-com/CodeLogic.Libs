{
  // Performance budgets checked by `dotnet run -c Release --project benchmarks/Data.Benchmarks -- --check-budgets benchmarks/budgets.json`
  // (CI job data-perf). maxAllocatedBytes: per operation, ~12% above the measurements (2026-10-31; single-row operations
  // lowered 2026-11-08 twice: no MySQL reset on open, then the lean execution round).
  // maxRatio: mean time relative to the category baseline in the same run (Dapper or raw ADO.NET, both without the driver's
  // reset on open, like CL.Data's default), so it holds across machines.
  // Lower a budget when an optimization lands; raise one only with a reason in the commit message.
  // Time ratios are 1.25 (not 1.15): on GitHub runners MySQL is on the same host, so a round trip is far under a
  // millisecond and library overhead weighs more than against a real server; short runs on shared runners add
  // noise (Filter100 measured 1.04 locally, 1.152 on CI). Allocations are the strict, reliable signal.
  // The 100-row filters allow more (2026-11-08): without the reset round trip on every open, the CI baseline fell
  // from ~550 to ~165 us while CL.Data's own overhead stayed ~45 us, so the same overhead is a larger ratio (CI 1.24-1.28).
  "benchmarks": {
    "CLData_GetById":            { "maxAllocatedBytes": 10200,   "maxRatio": 1.25 },
    "CLData_Compiled_GetById":   { "maxAllocatedBytes": 10400,   "maxRatio": 1.25 },
    "CLData_Cached_GetById":     { "maxAllocatedBytes": 1900,    "maxRatio": 0.05 },
    "CLData_Filter100":          { "maxAllocatedBytes": 44700,   "maxRatio": 1.40 },
    "CLData_Compiled_Filter100": { "maxAllocatedBytes": 38400,   "maxRatio": 1.35 },
    "CLData_Cached_Filter100":   { "maxAllocatedBytes": 18200,   "maxRatio": 0.10 },
    "CLData_Insert":             { "maxAllocatedBytes": 11200,   "maxRatio": 1.25 },
    "CLData_InsertMany100":      { "maxAllocatedBytes": 259000,  "maxRatio": 0.10 },
    "CLData_Bulk5000":           { "maxAllocatedBytes": 6200000, "maxRatio": 0.80 },
    "CLData_Update":             { "maxAllocatedBytes": 11800,   "maxRatio": 1.25 },
    "CLData_UpdateChanged":      { "maxAllocatedBytes": 9700,   "maxRatio": 1.25 },
    "CLData_Count":              { "maxAllocatedBytes": 11200,   "maxRatio": 1.25 },
    "CLData_Compiled_Count":     { "maxAllocatedBytes": 7200,    "maxRatio": 1.25 }
  }
}
