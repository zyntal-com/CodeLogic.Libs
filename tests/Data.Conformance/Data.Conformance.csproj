<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Provider-neutral conformance suite. A class library, not a test project: CI only runs
    tests/*/*.Tests.csproj, and each provider test project (Data.Sqlite.Tests, Data.MySql.Tests, ...)
    derives from the abstract suites here with its own fixture, so every provider runs the same tests.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CL.Data\CL.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
