<Project>
  <!--
    Target framework and language version for every project in the repo (libraries and tests).
    The 5.x line is .NET 11 only; .NET 10 consumers stay on 4.9.x (branch support/4.x).
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <!-- A switch over a C# 15 union or closed hierarchy (Result<T>, Error, StorageConnectionConfigBase)
         that misses a case is an error, so adding a case shows every place that must handle it. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
  </PropertyGroup>

  <!-- Shared NuGet metadata for all CL.* libraries -->
  <PropertyGroup>
    <Authors>Zyntal.com</Authors>
    <Copyright>Copyright © 2026 Zyntal.com</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zyntal-com/CodeLogic.Libs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zyntal-com/CodeLogic.Libs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Version is COMPOSED at build time, never hardcoded in a csproj.

      Major.Minor  ← repo-root version.txt (e.g. "4.8"), hand-controlled.
      Patch        ← the $(Patch) property. CI passes the GitHub run number
                     (-p:Patch=<run_number> or the whole -p:Version=...);
                     a local/dev build leaves it 0, giving a stable "4.8.0".

    CI publishes 4.8.<run_number>+<short-sha> (release) or
    4.8.<run_number>-preview+<short-sha> (prerelease). The run number is the
    monotonic, NuGet-orderable component (NuGet Patch is an Int32). The git
    sha is SemVer build-metadata: it is stripped by nuget.org and ignored for
    ordering, so it serves only as provenance — and it survives in
    InformationalVersion (hence InternalLibraryVersion.Current).

    AssemblyVersion / FileVersion are Win32 UInt16-per-field and cannot carry a
    -prerelease or +metadata suffix, so they are pinned to Major.Minor.0.0.
    That also keeps CLR assembly binding fixed per minor version, so every
    patch loads interchangeably (no exact-patch binding demands on consumers).
    AssemblyVersion itself is derived in Directory.Build.targets.
  -->
  <PropertyGroup>
    <_RootVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</_RootVersion>
    <Patch Condition="'$(Patch)' == ''">0</Patch>
    <!-- Set only when not supplied: CI's explicit -p:Version=/-p:PackageVersion= still wins. -->
    <Version Condition="'$(Version)' == ''">$(_RootVersion).$(Patch)</Version>
    <!-- Suffix-free, UInt16-safe Win32 file version. -->
    <FileVersion>$(_RootVersion).0.0</FileVersion>
    <!-- Full composed string incl. any +sha; read at runtime by InternalLibraryVersion. -->
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <!-- Include the repo-level LICENSE in every package -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Each library has its own CHANGELOG.md alongside the csproj. Packed into
       the NuGet root so consumers can read release notes without leaving
       the package. Condition keeps the build clean for libs that don't
       have one yet. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\CHANGELOG.md')">
    <None Include="$(MSBuildProjectDirectory)\CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Where CodeLogic comes from. Directory.Build.targets injects the reference.
    - Local development (5.x work in progress, owner decision 2026-10-31): when the sibling clone
      ../CodeLogic exists, every library builds against its source (a ProjectReference), so CodeLogic
      changes need no publish. Make sure the sibling is on the matching branch (main for 5.x).
    - CI and release pass -p:CodeLogicFromNuGet=true and build against the published package below.
      Before the 5.0 release, switch the local default back to NuGet and pin the published version.
    Override per build with -p:CodeLogicFromNuGet=true|false / -p:CodeLogicPackageVersion=... .
  -->
  <PropertyGroup>
    <CodeLogicFromNuGet Condition="'$(CodeLogicFromNuGet)' == '' And Exists('$(MSBuildThisFileDirectory)../CodeLogic/src/CodeLogic.csproj')">false</CodeLogicFromNuGet>
    <CodeLogicFromNuGet Condition="'$(CodeLogicFromNuGet)' == ''">true</CodeLogicFromNuGet>
    <!-- Pinned to the latest CodeLogic 5.0 preview on nuget.org (net11, union Result/Error). Bump it
         as new previews ship; switch to a 5.0.x GA version once CodeLogic 5.0 is stable. The release
         pipeline rewrites each published nuspec's CodeLogic dependency to the supported range. -->
    <CodeLogicPackageVersion Condition="'$(CodeLogicPackageVersion)' == ''">5.0.29-preview</CodeLogicPackageVersion>
  </PropertyGroup>
</Project>
